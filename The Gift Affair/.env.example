# Copy to .env.local for local development. Never commit .env.local.
# Leave the Supabase values empty to run the public site in demo mode
# with the bundled sample content (the admin area needs Supabase).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Not used by the app: every admin action runs as the signed-in editor and is
# checked by Row Level Security. Only add a secret key here if a future
# server-only script needs it, and never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: credentials for the admin end-to-end tests
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
